name: Blankdiss Research

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: research-manual
  cancel-in-progress: false

jobs:
  research:
    name: Run Blankdiss Research Matrix
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Fetch FI aggregate
        run: |
          python -u -m fi

      - name: Fetch prices
        run: |
          python -u -m prices --start 2022-01-01

      - name: Build features
        run: |
          python -u -m analysis.build_features

      - name: Verify feature dataset
        run: |
          python -m analysis.ci verify-features

      - name: Run Feature QC
        run: |
          python -u -m analysis.features_qc

      - name: Verify Feature QC
        run: |
          python -m analysis.ci verify-feature-qc

      - name: Run Research Matrix
        run: |
          python -u -m ml.research.runner

      - name: Verify research results
        run: |
          test -f data/processed/research/latest/experiment_results.jsonl
          test -f data/processed/research/latest/research_summary.json
          test -f data/processed/research/latest/research_report.md

          python - <<'PY'
          import json
          from pathlib import Path

          path = Path(
              "data/processed/research/latest/research_summary.json"
          )

          data = json.loads(
              path.read_text(encoding="utf-8")
          )

          result_count = data.get("result_count", 0)

          if result_count == 0:
              raise SystemExit(
                  "Research summary innehåller inga resultat."
              )

          print(
              "Research results:",
              result_count,
          )

          print(
              "Status counts:",
              data.get("status_counts", {}),
          )
          PY

      - name: Upload research artifacts
        uses: actions/upload-artifact@v4
        with:
          name: blankdiss-research
          path: |
            data/processed/research/latest/experiment_results.jsonl
            data/processed/research/latest/research_summary.json
            data/processed/research/latest/research_report.md
            data/processed/research/runs/*/experiment_results.jsonl
            data/processed/research/runs/*/research_summary.json
            data/processed/research/runs/*/research_report.md
          if-no-files-found: error
